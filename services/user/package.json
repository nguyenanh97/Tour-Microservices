  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/joi": "^17.2.3",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/sequelize": "^6.12.0",
    "nodemon": "^3.1.0",
